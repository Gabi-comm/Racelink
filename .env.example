# copy to .env.local, never commit the real one

# mysql (local) / rds (aws)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=racelink
DB_PASSWORD=
DB_NAME=racelink_v2
DB_SSL=false

# better auth, secret: 32+ random chars
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# s3, no access keys, ec2 uses the iam role
AWS_REGION=ap-southeast-1
S3_BUCKET=

# email: new race requests are sent to racelinkcc@gmail.com
# gmail: SMTP_USER = the sending gmail, SMTP_PASS = a 16-char app password
# leave blank to skip emails (requests still show in Request Forms)
SMTP_USER=
SMTP_PASS=
# optional, defaults to smtp.gmail.com:465
SMTP_HOST=
SMTP_PORT=
